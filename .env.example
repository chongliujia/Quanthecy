# Local development only. Production overrides and setup are documented in README.
DJANGO_SECRET_KEY=quanthecy-local-development-only-do-not-use-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
POSTGRES_DB=quanthecy
POSTGRES_USER=quanthecy
POSTGRES_PASSWORD=quanthecy-dev-only
CLICKHOUSE_DATABASE=quanthecy
CLICKHOUSE_USER=quanthecy
CLICKHOUSE_PASSWORD=quanthecy-dev-only
WEB_PORT=3000
BACKEND_PORT=8000
# Production: set a DNS name and fresh secrets before using compose.prod.yaml.
# QUANTHECY_DOMAIN=research.example.com
# Public REST collection: bounded binary YES outcomes, pinned after first discovery.
COLLECTOR_INTERVAL_SECONDS=60
COLLECTOR_MARKETS_PER_PLATFORM=10
POLYMARKET_API_URL=https://gamma-api.polymarket.com
KALSHI_API_URL=https://external-api.kalshi.com/trade-api/v2
# Optional comma-separated IDs override discovery; at most 50 per platform.
POLYMARKET_MARKET_IDS=
KALSHI_MARKET_TICKERS=
# Official Federal Reserve feeds; metadata/excerpts only, every 15 minutes per source.
NEWS_FEEDS_ENABLED=true
NEWS_PROXY_URL=

# Model credentials are configured per workspace in the web UI. Disabled by default.
# Generate a Fernet key once; keep it stable and back it up separately from the database.
AGENT_ENCRYPTION_KEY=
# Exact trusted base URLs. Add your compatible/local endpoint here before web configuration.
# Empty uses the built-in public provider catalog. Set a comma-separated list to override.
AGENT_ALLOWED_ENDPOINTS=
